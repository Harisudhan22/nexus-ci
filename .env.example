# PostgreSQL Database Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ci

# Neo4j Database Config
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# FastAPI Security Config
JWT_SECRET=dev-jwt-secret-key-for-nexus-ci-hackathon-2026

# Document Upload Folder path
UPLOAD_DIR=./uploads

# Grounded Copilot LLM Configurations
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Next.js API Gateway Config
API_URL=http://localhost:8000/api
