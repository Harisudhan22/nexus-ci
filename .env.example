# ============================================================
# NEXUS-CI Environment Configuration
# ============================================================

# PostgreSQL Database Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ci

# Neo4j Database Config
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# FastAPI Security Config
JWT_SECRET=dev-jwt-secret-key-for-nexus-ci-hackathon-2026

# Document Upload Folder path
UPLOAD_DIR=./uploads

# ── LLM Multi-Provider Configuration ────────────────────────
# Options: gemini, groq, openai, ollama, local
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Infrastructure ──────────────────────────────────────────
# Redis task queue (optional — falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Vector search backend: "pgvector" or "in_memory"
VECTOR_BACKEND=pgvector
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSION=64

# Object storage backend: "local" or "s3"
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=nexus-ci-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Speech-to-text provider: "whisper" or "mock"
STT_PROVIDER=mock

# ── Security & Observability ────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
LOG_FORMAT=text
LOG_LEVEL=INFO

# Next.js API Gateway Config
API_URL=http://localhost:8000/api
